          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(amount) FILTER (WHERE is_fraud = 1),0) AS \"Montant fraude\" FROM transactions_scored WHERE $__timeFilter(ts)"
